  import type { default as FxCardElement } from '@holyfloe/fixtures/fx-card/fx-card.js';
  import type { Snippet } from 'svelte';
  import type { HTMLAttributes } from 'svelte/elements';

  export type FxCardProps = Partial<Pick<FxCardElement, 'elevated'>> & {
    /** The custom element, for `bind:element`. */
    element?: FxCardElement;
    /** Card body. */
    children?: Snippet;
    /** Content for the card header. */
    header?: Snippet;
    /** Content for the card footer. */
    footer?: Snippet;
  } & Omit<HTMLAttributes<FxCardElement>, 'elevated' | 'element' | 'children' | 'header' | 'footer'>;
</script>

<!--
  @component
  A content card with header and footer slots.

  Slots:
  - default: Card body.
  - header: Content for the card header.
  - footer: Content for the card footer.

  CSS parts:
  - base: The card container.
  - header: The header wrapper.
  - footer: The footer wrapper.

  CSS custom properties:
  - --fx-card-padding: Inner padding. Defaults to 16px.
  - --fx-card-radius: Corner radius. Defaults to 8px.
-->
<script lang="ts">
  import '@holyfloe/fixtures/fx-card/fx-card.js';
  import { defined } from './svelte-utils.js';

  let { elevated, element = $bindable(), children, header, footer, ...rest }: FxCardProps = $props();

  // Set as properties, skipping `undefined`: Complex and attribute-less props have no attribute
  // form, and a Boolean attribute can only be present or absent (absent would leave `undefined`,
  // not `false`). `Object.assign` because a getter and its setter may differ in type (Web Awesome
  // `form` reads as `HTMLFormElement | null` and is set with a form id).
  $effect(() => {
    if (element) Object.assign(element, defined({ elevated }));
  });
</script>

<!-- A named slot is a `display: contents` wrapper carrying the `slot` attribute (a snippet cannot
     carry one). It is left out when the slot is not given: an empty assigned node would hide the
     slot's fallback content. -->
<fx-card
  bind:this={element}
  {...rest}
  elevated={elevated || undefined}
>
  {@render children?.()}
  {#if header}<span slot="header" style="display: contents">{@render header()}</span>{/if}
  {#if footer}<span slot="footer" style="display: contents">{@render footer()}</span>{/if}
</fx-card>
