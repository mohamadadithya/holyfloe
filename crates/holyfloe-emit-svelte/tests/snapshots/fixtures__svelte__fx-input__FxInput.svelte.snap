  import type { FxInput as FxInputElement } from '@holyfloe/fixtures/fx-input/fx-input.js';
  import type { Snippet } from 'svelte';
  import type { HTMLAttributes } from 'svelte/elements';
  import type { TypedEvent } from './svelte-utils.js';

  export type FxInputProps = Partial<Pick<FxInputElement, 'value' | 'name' | 'disabled'>> & {
    /** Fired when the user commits a value. Has no detail; read `value`. */
    onChange?: (event: TypedEvent<FxInputElement, unknown>) => void;
