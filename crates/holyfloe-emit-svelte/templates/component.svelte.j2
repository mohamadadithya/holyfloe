{% import "macros.j2" as m %}
{% set el = c.name ~ "Element" %}
{# Read-only props are not props: assigning a getter-only property throws. #}
{% set props = c.props | rejectattr("readonly") | list %}
{% set default_slot = c.slots | rejectattr("name") | list %}
{% set named_slots = c.slots | selectattr("name") | list %}
{# Locals the component binds itself. A prop with one of these names, or a reserved word, binds `<name>_`. #}
{% set taken = ["element", "children", "rest"] + (named_slots | map(attribute="name") | list) %}
{% set ns = namespace(fields=[], models=[], keys=[], effect=[]) %}
{% for p in props %}
{% set local = p.name | js_local(taken) %}
{% set field = p.name if local == p.name else p.name ~ ": " ~ local %}
{% set bound = c.bindings | selectattr("prop", "equalto", p.name) | list %}
{% set ns.fields = ns.fields + [field ~ (" = $bindable()" if bound else "")] %}
{% if p.kind == "Boolean" or p.kind == "Complex" or p.attribute is none %}
{% set ns.effect = ns.effect + ["if (" ~ local ~ " !== undefined) element." ~ p.name ~ " = " ~ local ~ ";"] %}
{% endif %}
{% endfor %}
{% for b in c.bindings %}
{% set ns.models = ns.models + ["Two-way binding: `bind:" ~ b.prop ~ "` (updated from `" ~ b.event ~ "`)."] %}
{% endfor %}
{% set ns.fields = ns.fields + (c.events | map(attribute="base_name") | map("svelte_on") | list) + ["element = $bindable()", "children"] + (named_slots | map(attribute="name") | list) + ["...rest"] %}
{% set ns.keys = (props | map(attribute="name") | list) + (c.events | map(attribute="base_name") | map("svelte_on") | list) %}
{% for e in c.events %}
{% if ("on" ~ e.dom_name) not in ns.keys %}
{% set ns.keys = ns.keys + ["on" ~ e.dom_name] %}
{% endif %}
{% endfor %}
{% set ns.keys = ns.keys + ["element", "children"] + (named_slots | map(attribute="name") | list) %}
{% set doc = m.component_doc(c, ns.models) | trim %}
{% macro detail(e) %}{{ e.detail.text if e.detail else "unknown" }}{% endmacro %}
{% macro read(v) %}{% if v == "Detail" %}e.detail{% elif v.DetailField is defined %}e.detail.{{ v.DetailField }}{% else %}e.currentTarget.{{ v.TargetProp }}{% endif %}{% endmacro %}
<!-- Generated by holyfloe. Do not edit. -->
<script module lang="ts">
  import type { {{ c.export_name }} as {{ el }} } from {{ c.module.specifier | ts_string }};
{% for specifier, names in imports | items %}
  import type { {{ names | join(", ") }} } from {{ specifier | ts_string }};
{% endfor %}
  import type { Snippet } from 'svelte';
  import type { HTMLAttributes } from 'svelte/elements';
{% if c.events %}
  import type { TypedEvent } from './svelte-utils.js';
{% endif %}

  export type {{ c.name }}Props = {{ ("Partial<Pick<" ~ el ~ ", " ~ (props | map(attribute="name") | map("ts_string") | join(" | ")) ~ ">> & ") if props else "" }}{
{% for e in c.events %}
{% set d = m.member_doc(e) %}
{% if d %}
    {{ d | indent(4) }}
{% endif %}
    on{{ e.base_name }}?: (event: TypedEvent<{{ el }}, {{ detail(e) }}>) => void;
{% endfor %}
    /** The custom element, for `bind:element`. */
    element?: {{ el }};
{% set d = m.member_doc(default_slot[0]) if default_slot else "" %}
{% if d %}
    {{ d | indent(4) }}
{% endif %}
    children?: Snippet;
{% for s in named_slots %}
{% set d = m.member_doc(s) %}
{% if d %}
    {{ d | indent(4) }}
{% endif %}
    {{ s.name | ts_key }}?: Snippet;
{% endfor %}
  } & Omit<HTMLAttributes<{{ el }}>, {{ ns.keys | map("ts_string") | join(" | ") }}>;
</script>

{% if doc %}
<!--
  @component
  {{ doc | indent(2) }}
-->
{% endif %}
<script lang="ts">
  import {{ c.definition.specifier | ts_string }};

  let { {{ ns.fields | join(", ") }} }: {{ c.name }}Props = $props();
{% if ns.effect %}

  // Set as properties: Complex and attribute-less props have no attribute form, and a Boolean
  // attribute can only be present or absent (absent would leave `undefined`, not `false`).
  $effect(() => {
    if (!element) return;
{% for line in ns.effect %}
    {{ line }}
{% endfor %}
  });
{% endif %}
</script>

{% if named_slots %}
<!-- A named slot is a `display: contents` wrapper carrying the `slot` attribute (a snippet cannot
     carry one). It is left out when the slot is not given: an empty assigned node would hide the
     slot's fallback content. -->
{% endif %}
{% if c.events | map(attribute="dom_name") | select("svelte_capture") | list %}
<!-- `on<name>capture` listeners: Svelte delegates some event names (`change`, `click`, ...) to the
     root, which only sees events that bubble. A capture listener on the host fires either way. -->
{% endif %}
<{{ c.tag }}
  bind:this={element}
  {...rest}
{% for p in props if p.attribute is not none and p.kind != "Complex" %}
{% set local = p.name | js_local(taken) %}
{% if p.kind == "Boolean" %}
  {{ p.attribute }}={{ "{" }}{{ local }} || undefined}
{% elif p.attribute == local %}
  {{ "{" }}{{ local }}}
{% else %}
  {{ p.attribute }}={{ "{" }}{{ local }}}
{% endif %}
{% endfor %}
{% for e in c.events %}
{% set bound = c.bindings | selectattr("event", "equalto", e.dom_name) | list %}
{% set attr = "on" ~ e.dom_name ~ ("capture" if e.dom_name is svelte_capture else "") %}
{% if bound %}
  {{ attr }}={(event: Event) => {
    const e = event as TypedEvent<{{ el }}, {{ detail(e) }}>;
{% for b in bound %}
    {{ b.prop | js_local(taken) }} = {{ read(b.value) }};
{% endfor %}
    on{{ e.base_name }}?.(e);
  }}
{% else %}
  {{ attr }}={(event: Event) => on{{ e.base_name }}?.(event as TypedEvent<{{ el }}, {{ detail(e) }}>)}
{% endif %}
{% endfor %}
>
  {@render children?.()}
{% for s in named_slots %}
  {{ "{#if " ~ s.name ~ "}" }}<span slot="{{ s.name }}" style="display: contents">{{ "{@render " ~ s.name ~ "()}" }}</span>{{ "{/if}" }}
{% endfor %}
</{{ c.tag }}>
