// Generated by holyfloe. Do not edit.
import '@holyfloe/fixtures/fx-select/fx-select.js';
import type { FxSelect as FxSelectElement } from '@holyfloe/fixtures/fx-select/fx-select.js';
import { defineComponent, h, shallowRef, type PropType, type SlotsType, type VNode } from 'vue';
import { defined, type TypedEvent } from './vue-utils.js';

/**
 * Picks one option. The new value travels in `detail.value`; the binding comes from config.
 *
 * Two-way binding: `v-model` (`value`, updated from `fx-change`).
 */
export const FxSelect = defineComponent({
  name: 'FxSelect',
  props: {
    /** The picked option. Bound with `v-model`. */
    modelValue: { type: null as unknown as PropType<FxSelectElement['value']> },
    /** Options to pick from. */
    options: { type: null as unknown as PropType<FxSelectElement['options']> },
  },
  emits: {
    /** Fired when the user picks an option. */
    FxChange: (event: TypedEvent<FxSelectElement, { value: string }>) => true,
    'update:modelValue': (value: FxSelectElement['value']) => true,
  },
  slots: Object as SlotsType<{ default?: () => VNode[] }>,
  setup() {
    /** The custom element. */
    const element = shallowRef<FxSelectElement>();
    return { element };
  },
  render() {
    return h(
      'fx-select',
      defined({
        ref: 'element',
        value: this.modelValue,
        '.options': this.options,
        'on:fx-change': (event: Event) => {
          const e = event as TypedEvent<FxSelectElement, { value: string }>;
          this.$emit('update:modelValue', e.detail.value);
          this.$emit('FxChange', e);
        },
      }),
      this.$slots.default?.(),
    );
  },
});
