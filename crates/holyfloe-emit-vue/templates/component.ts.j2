{% endif %}
    return h(
      {{ c.tag | ts_string }},
      defined({
        ref: 'element',
{# Attributes render in SSR HTML; Complex props and props without an attribute are forced properties. #}
{% for p in props %}
{% set value = "this." ~ vue_prop(p.name) %}
{% if p.attribute is none or p.kind == "Complex" %}
