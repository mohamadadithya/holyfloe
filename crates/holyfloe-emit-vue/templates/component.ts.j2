{% endfor %}
{% for b in c.bindings %}
    {{ ("update:" ~ vue_prop(b.prop)) | ts_string }}: (value: {{ el }}[{{ b.prop | ts_string }}]) => true,
{% endfor %}
  },
{% endif %}
{% if named_slots %}
  slots: Object as SlotsType<{
    default?: () => VNode[];
{% for s in named_slots %}
{% set d = m.member_doc(s) %}
{% if d %}
    {{ d | indent(4) }}
{% endif %}
    {{ s.name | ts_key }}?: () => VNode[];
{% endfor %}
  }>,
{% else %}
  slots: Object as SlotsType<{ default?: () => VNode[] }>,
{% endif %}
  setup() {
    /** The custom element. */
    const element = shallowRef<{{ el }}>();
{% if c.methods %}
    return {
      element,
{% for x in c.methods %}
{% set d = m.member_doc(x) %}
{% if d %}
      {{ d | indent(6) }}
{% endif %}
