{% import "macros.j2" as m %}
{% set el = c.name ~ "Element" %}
{# Read-only props are not props: assigning a getter-only property throws. #}
{% set props = c.props | rejectattr("readonly") | list %}
{% set named_slots = c.slots | selectattr("name") | list %}
{% set ns = namespace(models=[]) %}
{% for b in c.bindings %}
{% set ns.models = ns.models + ["Two-way binding: " ~ (("`v-model` (`" ~ b.prop ~ "`, updated from `" ~ b.event ~ "`).") if b.prop == "value" else ("`v-model:" ~ b.prop ~ "` (updated from `" ~ b.event ~ "`)."))] %}
{% endfor %}
{% set doc = m.component_doc(c, ns.models) | jsdoc %}
{# The Vue prop a component prop becomes: `value` with a binding is `modelValue` (v-model). #}
{% macro vue_prop(name) %}{{ "modelValue" if name == "value" and c.bindings | selectattr("prop", "equalto", "value") | list else name }}{% endmacro %}
{% macro detail(e) %}{{ e.detail.text if e.detail else "unknown" }}{% endmacro %}
{% macro read(v) %}{% if v == "Detail" %}e.detail{% elif v.DetailField is defined %}e.detail.{{ v.DetailField }}{% else %}e.currentTarget.{{ v.TargetProp }}{% endif %}{% endmacro %}
{# A listener: re-emits the event under `base_name`, after the `update:` emits of its bindings. #}
{% macro listener(e) %}
{% set bound = c.bindings | selectattr("event", "equalto", e.dom_name) | list %}
{% if bound %}
(event: Event) => {
  const e = event as TypedEvent<{{ el }}, {{ detail(e) }}>;
{% for b in bound %}
  this.$emit({{ ("update:" ~ vue_prop(b.prop)) | ts_string }}, {{ read(b.value) }});
{% endfor %}
  this.$emit({{ e.base_name | ts_string }}, e);
}
{%- else %}
(event: Event) => this.$emit({{ e.base_name | ts_string }}, event as TypedEvent<{{ el }}, {{ detail(e) }}>)
{%- endif %}
{% endmacro %}
{% set vue = [
  "defineComponent",
  "h",
  "shallowRef",
  "type PropType" if props else none,
  "type SlotsType",
  "type VNode",
] | select | join(", ") %}
