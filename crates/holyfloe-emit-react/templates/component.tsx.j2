{% import "macros.j2" as m %}
{% set el = c.name ~ "Element" %}
{# Read-only props are not props: assigning a getter-only property throws. #}
{% set props = c.props | rejectattr("readonly") | list %}
{# Locals the wrapper binds itself. A prop with one of these names, or a reserved word, binds `<name>_`. #}
{% set taken = ["ref", "rest", "forwardedRef", "createElement", "forwardRef", "useImperativeHandle", "useRef", "useEventListener", "useProperties"] %}
{% set ns = namespace(bindings=[], events=[]) %}
{% for p in props %}
{% set local = p.name | js_local(taken) %}
{% set ns.bindings = ns.bindings + [p.name if local == p.name else p.name ~ ": " ~ local] %}
{% endfor %}
{% for e in c.events %}
{% set ns.events = ns.events + ["on" ~ e.base_name] %}
{% endfor %}
{% set own_keys = (props | map(attribute="name") | list) + ns.events + (["style"] if c.css_props else []) %}
{% set fields = ns.bindings + ns.events + ([] if forward_ref else ["ref: forwardedRef"]) + ["...rest"] %}
{% set react = [
  "createElement",
  "forwardRef" if forward_ref else none,
  "useImperativeHandle",
  "useRef",
  "type CSSProperties" if c.css_props else none,
  "type HTMLAttributes",
  none if forward_ref else "type Ref",
] | select | join(", ") %}
{% set utils = [
  "useEventListener" if c.events else none,
  "useProperties" if props else none,
  "type TypedEvent" if c.events else none,
] | select | join(", ") %}
{% set props_type = [
  ("Partial<Pick<" ~ el ~ ", " ~ (props | map(attribute="name") | map("ts_string") | join(" | ")) ~ ">>") if props else none,
  (c.name ~ "EventProps") if c.events else none,
  ("{ style?: " ~ c.name ~ "Style }") if c.css_props else none,
  none if forward_ref else ("{ ref?: Ref<" ~ el ~ "> }"),
  ("Omit<HTMLAttributes<" ~ el ~ ">, " ~ (own_keys | map("ts_string") | join(" | ")) ~ ">") if own_keys else ("HTMLAttributes<" ~ el ~ ">"),
] | select | join(" &\n  ") %}
{% set doc = m.component_doc(c) | jsdoc %}
{% if use_client %}
'use client';
{% endif %}
// Generated by holyfloe. Do not edit.
import {{ c.definition.specifier | ts_string }};
import type { {{ c.export_name }} as {{ el }} } from {{ c.module.specifier | ts_string }};
{% for specifier, names in imports | items %}
import type { {{ names | join(", ") }} } from {{ specifier | ts_string }};
{% endfor %}
import { {{ react }} } from 'react';
{% if utils %}
import { {{ utils }} } from './react-utils.js';
{% endif %}
{% if c.css_props %}

export type {{ c.name }}Style = CSSProperties & {
{% for p in c.css_props %}
{% set d = m.member_doc(p) %}
{% if d %}
  {{ d | indent(2) }}
{% endif %}
  {{ p.name | ts_key }}?: string;
{% endfor %}
};
{% endif %}
{% if c.events %}

export type {{ c.name }}EventProps = {
{% for e in c.events %}
{% set d = m.member_doc(e) %}
{% if d %}
  {{ d | indent(2) }}
{% endif %}
  on{{ e.base_name }}?: (event: TypedEvent<{{ el }}, {{ e.detail.text if e.detail else "unknown" }}>) => void;
{% endfor %}
};
{% endif %}

export type {{ c.name }}Props = {{ props_type }};

{% if doc %}
{{ doc }}
{% endif %}
{% if forward_ref %}
export const {{ c.name }} = forwardRef<{{ el }}, {{ c.name }}Props>(function {{ c.name }}(
  { {{ fields | join(", ") }} },
  forwardedRef,
) {
{% else %}
export function {{ c.name }}(
  { {{ fields | join(", ") }} }: {{ c.name }}Props,
) {
{% endif %}
  const ref = useRef<{{ el }}>(null);
  useImperativeHandle(forwardedRef, () => ref.current as {{ el }});
{% if props %}
  useProperties(ref, {{ c.tag | ts_string }}, { {{ ns.bindings | join(", ") }} });
{% endif %}
{% for e in c.events %}
  useEventListener(ref, {{ e.dom_name | ts_string }}, on{{ e.base_name }});
{% endfor %}
  return createElement({{ c.tag | ts_string }}, {
    // Lit reflects defaults when the element upgrades, before hydration: those attributes are its own.
    suppressHydrationWarning: true,
    ...rest,
    ref,
{# Attributes render in SSR HTML. Complex props and props without an attribute are properties only. #}
{% for p in props if p.attribute is not none and p.kind != "Complex" %}
{% set local = p.name | js_local(taken) %}
{% if p.kind == "Boolean" %}
    {{ p.attribute | ts_key }}: {{ local }} ? '' : undefined,
{% elif p.attribute == local %}
    {{ local }},
{% else %}
    {{ p.attribute | ts_key }}: {{ local }},
{% endif %}
{% endfor %}
  });
{{ "});" if forward_ref else "}" }}
