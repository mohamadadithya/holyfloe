import {{ c.definition.specifier | ts_string }};
import type { {{ c.class_name }} as {{ el }} } from {{ c.module.specifier | ts_string }};
{% for specifier, names in imports | items %}
import type { {{ names | join(", ") }} } from {{ specifier | ts_string }};
{% endfor %}
import { {{ react }} } from 'react';
{% if utils %}
import { {{ utils }} } from './react-utils.js';
{% endif %}
{% if c.css_props %}

export type {{ c.name }}Style = CSSProperties & {
{% for p in c.css_props %}
{% set d = m.member_doc(p) %}
{% if d %}
  {{ d | indent(2) }}
{% endif %}
  {{ p.name | ts_key }}?: string;
{% endfor %}
};
{% endif %}
{% if c.events %}

export type {{ c.name }}EventProps = {
{% for e in c.events %}
{% set d = m.member_doc(e) %}
{% if d %}
  {{ d | indent(2) }}
{% endif %}
  on{{ e.base_name }}?: (event: TypedEvent<{{ el }}, {{ e.detail.text if e.detail else "unknown" }}>) => void;
{% endfor %}
};
{% endif %}

export type {{ c.name }}Props = {{ props_type }};

{% if doc %}
{{ doc }}
{% endif %}
{% if forward_ref %}
export const {{ c.name }} = forwardRef<{{ el }}, {{ c.name }}Props>(function {{ c.name }}(
  { {{ fields | join(", ") }} },
  forwardedRef,
) {
{% else %}
export function {{ c.name }}(
  { {{ fields | join(", ") }} }: {{ c.name }}Props,
) {
{% endif %}
  const ref = useRef<{{ el }}>(null);
  useImperativeHandle(forwardedRef, () => ref.current as {{ el }});
{% if props %}
  useProperties(ref, {{ c.tag | ts_string }}, { {{ props | map(attribute="name") | join(", ") }} });
{% endif %}
{% for e in c.events %}
  useEventListener(ref, {{ e.dom_name | ts_string }}, on{{ e.base_name }});
{% endfor %}
  return createElement({{ c.tag | ts_string }}, {
    ...rest,
    ref,
{# Attributes render in SSR HTML. Complex props and props without an attribute are properties only. #}
{% for p in props if p.attribute is not none and p.kind != "Complex" %}
{% if p.kind == "Boolean" %}
    {{ p.attribute | ts_key }}: {{ p.name }} ? '' : undefined,
{% elif p.attribute == p.name %}
    {{ p.name }},
{% else %}
    {{ p.attribute | ts_key }}: {{ p.name }},
{% endif %}
{% endfor %}
  });
{{ "});" if forward_ref else "}" }}
