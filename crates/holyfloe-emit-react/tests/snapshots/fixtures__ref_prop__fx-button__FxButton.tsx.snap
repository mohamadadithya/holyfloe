'use client';
// Generated by holyfloe. Do not edit.
import '@holyfloe/fixtures/fx-button/fx-button.js';
import type { FxButton as FxButtonElement } from '@holyfloe/fixtures/fx-button/fx-button.js';
import { createElement, useImperativeHandle, useRef, type HTMLAttributes, type Ref } from 'react';
import { useEventListener, useProperties, type TypedEvent } from './react-utils.js';

export type FxButtonEventProps = {
  /** Fired when the button is activated. Has no detail. */
  onFxPress?: (event: TypedEvent<FxButtonElement, unknown>) => void;
};

export type FxButtonProps = Partial<Pick<FxButtonElement, 'variant' | 'disabled'>> &
  FxButtonEventProps &
  { ref?: Ref<FxButtonElement> } &
  Omit<HTMLAttributes<FxButtonElement>, 'variant' | 'disabled' | 'onFxPress'>;

/**
 * Basic action button.
 *
 * A clickable button.
 *
 * Slots:
 * - default: The button label.
 */
export function FxButton(
  { variant, disabled, onFxPress, ref: forwardedRef, ...rest }: FxButtonProps,
) {
  const ref = useRef<FxButtonElement>(null);
  useImperativeHandle(forwardedRef, () => ref.current as FxButtonElement);
  useProperties(ref, 'fx-button', { variant, disabled });
  useEventListener(ref, 'fx-press', onFxPress);
  return createElement('fx-button', {
    ...rest,
    ref,
    variant,
    disabled: disabled ? '' : undefined,
  });
}
