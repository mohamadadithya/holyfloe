'use client';
// Generated by holyfloe. Do not edit.
import '@holyfloe/fixtures/fx-list/fx-list.js';
import type { FxList as FxListElement } from '@holyfloe/fixtures/fx-list/fx-list.js';
import { createElement, forwardRef, useImperativeHandle, useRef, type HTMLAttributes } from 'react';
import { useProperties } from './react-utils.js';

export type FxListProps = Partial<Pick<FxListElement, 'items' | 'options' | 'renderLabel'>> &
  Omit<HTMLAttributes<FxListElement>, 'items' | 'options' | 'renderLabel'>;

/**
 * Renders a list of items. All props are complex and set as properties.
 */
export const FxList = forwardRef<FxListElement, FxListProps>(function FxList(
  { items, options, renderLabel, ...rest },
  forwardedRef,
) {
  const ref = useRef<FxListElement>(null);
  useImperativeHandle(forwardedRef, () => ref.current as FxListElement);
  useProperties(ref, 'fx-list', { items, options, renderLabel });
  return createElement('fx-list', {
    // Lit reflects defaults when the element upgrades, before hydration: those attributes are its own.
    suppressHydrationWarning: true,
    ...rest,
    ref,
  });
});
