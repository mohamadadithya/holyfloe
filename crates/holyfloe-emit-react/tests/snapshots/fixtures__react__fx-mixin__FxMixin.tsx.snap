'use client';
// Generated by holyfloe. Do not edit.
import '@holyfloe/fixtures/fx-mixin/fx-mixin.js';
import type { FxMixin as FxMixinElement } from '@holyfloe/fixtures/fx-mixin/fx-mixin.js';
import { createElement, forwardRef, useImperativeHandle, useRef, type HTMLAttributes } from 'react';
import { useEventListener, useProperties, type TypedEvent } from './react-utils.js';

export type FxMixinEventProps = {
  onFocusChange?: (event: TypedEvent<FxMixinElement, unknown>) => void;
};

export type FxMixinProps = Partial<Pick<FxMixinElement, 'prefix' | 'focused' | 'ringColor'>> &
  FxMixinEventProps &
  Omit<HTMLAttributes<FxMixinElement>, 'prefix' | 'focused' | 'ringColor' | 'onFocusChange'>;

/**
 * Gets `focused`, `ringColor` and the `focus-change` event from a mixin in another package.
 *
 * Slots:
 * - default: The label.
 */
export const FxMixin = forwardRef<FxMixinElement, FxMixinProps>(function FxMixin(
  { prefix, focused, ringColor, onFocusChange, ...rest },
  forwardedRef,
) {
  const ref = useRef<FxMixinElement>(null);
  useImperativeHandle(forwardedRef, () => ref.current as FxMixinElement);
  useProperties(ref, 'fx-mixin', { prefix, focused, ringColor });
  useEventListener(ref, 'focus-change', onFocusChange);
  return createElement('fx-mixin', {
    // Lit reflects defaults when the element upgrades, before hydration: those attributes are its own.
    suppressHydrationWarning: true,
    ...rest,
    ref,
    prefix,
    focused: focused ? '' : undefined,
    'ring-color': ringColor,
  });
});
