'use client';
// Generated by holyfloe. Do not edit.
import '@holyfloe/fixtures/fx-card/fx-card.js';
import type { default as FxCardElement } from '@holyfloe/fixtures/fx-card/fx-card.js';
import { createElement, forwardRef, useImperativeHandle, useRef, type CSSProperties, type HTMLAttributes } from 'react';
import { useProperties } from './react-utils.js';

export type FxCardStyle = CSSProperties & {
  /** Inner padding. Defaults to 16px. */
  '--fx-card-padding'?: string;
  /** Corner radius. Defaults to 8px. */
  '--fx-card-radius'?: string;
};

export type FxCardProps = Partial<Pick<FxCardElement, 'elevated'>> &
  { style?: FxCardStyle } &
  Omit<HTMLAttributes<FxCardElement>, 'elevated' | 'style'>;

/**
 * A content card with header and footer slots.
 *
 * Slots:
 * - default: Card body.
 * - header: Content for the card header.
 * - footer: Content for the card footer.
 *
 * CSS parts:
 * - base: The card container.
 * - header: The header wrapper.
 * - footer: The footer wrapper.
 *
 * CSS custom properties:
 * - --fx-card-padding: Inner padding. Defaults to 16px.
 * - --fx-card-radius: Corner radius. Defaults to 8px.
 */
export const FxCard = forwardRef<FxCardElement, FxCardProps>(function FxCard(
  { elevated, ...rest },
  forwardedRef,
) {
  const ref = useRef<FxCardElement>(null);
  useImperativeHandle(forwardedRef, () => ref.current as FxCardElement);
  useProperties(ref, 'fx-card', { elevated });
  return createElement('fx-card', {
    // Lit reflects defaults when the element upgrades, before hydration: those attributes are its own.
    suppressHydrationWarning: true,
    ...rest,
    ref,
    elevated: elevated ? '' : undefined,
  });
});
