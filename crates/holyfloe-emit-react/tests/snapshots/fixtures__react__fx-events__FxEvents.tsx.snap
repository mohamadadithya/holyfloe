'use client';
// Generated by holyfloe. Do not edit.
import '@holyfloe/fixtures/fx-events/fx-events.js';
import type { FxEvents as FxEventsElement } from '@holyfloe/fixtures/fx-events/fx-events.js';
import { createElement, forwardRef, useImperativeHandle, useRef, type HTMLAttributes } from 'react';
import { useEventListener, type TypedEvent } from './react-utils.js';

export type FxEventsEventProps = {
  /** Kebab-case name. */
  onMyChange?: (event: TypedEvent<FxEventsElement, { value: string }>) => void;
  /** camelCase name. */
  onMyChangeCamel?: (event: TypedEvent<FxEventsElement, { value: number }>) => void;
  /** PascalCase name. */
  onMyChangePascal?: (event: TypedEvent<FxEventsElement, { checked: boolean }>) => void;
  /** Uppercase name. */
  onMYEVENT?: (event: TypedEvent<FxEventsElement, { count: number }>) => void;
};

export type FxEventsProps = FxEventsEventProps &
  Omit<HTMLAttributes<FxEventsElement>, 'onMyChange' | 'onMyChangeCamel' | 'onMyChangePascal' | 'onMYEVENT'>;

/**
 * Dispatches events whose names use every common casing.
 */
export const FxEvents = forwardRef<FxEventsElement, FxEventsProps>(function FxEvents(
  { onMyChange, onMyChangeCamel, onMyChangePascal, onMYEVENT, ...rest },
  forwardedRef,
) {
  const ref = useRef<FxEventsElement>(null);
  useImperativeHandle(forwardedRef, () => ref.current as FxEventsElement);
  useEventListener(ref, 'my-change', onMyChange);
  useEventListener(ref, 'myChange', onMyChangeCamel);
  useEventListener(ref, 'MyChange', onMyChangePascal);
  useEventListener(ref, 'MYEVENT', onMYEVENT);
  return createElement('fx-events', {
    // Lit reflects defaults when the element upgrades, before hydration: those attributes are its own.
    suppressHydrationWarning: true,
    ...rest,
    ref,
  });
});
