'use client';
// Generated by holyfloe. Do not edit.
import '@holyfloe/fixtures/fx-lazy/fx-lazy.js';
import type { FxLazy as FxLazyElement } from '@holyfloe/fixtures/fx-lazy/fx-lazy.js';
import { createElement, forwardRef, useImperativeHandle, useRef, type HTMLAttributes } from 'react';
import { useProperties } from './react-utils.js';

export type FxLazyProps = Partial<Pick<FxLazyElement, 'items' | 'label' | 'active'>> &
  Omit<HTMLAttributes<FxLazyElement>, 'items' | 'label' | 'active'>;

/**
 * Not defined on import: apps call `defineFxLazy()` after their first render, so wrappers
 * meet an element that is not upgraded yet.
 *
 * CSS parts:
 * - label: The label.
 */
export const FxLazy = forwardRef<FxLazyElement, FxLazyProps>(function FxLazy(
  { items, label, active, ...rest },
  forwardedRef,
) {
  const ref = useRef<FxLazyElement>(null);
  useImperativeHandle(forwardedRef, () => ref.current as FxLazyElement);
  useProperties(ref, 'fx-lazy', { items, label, active });
  return createElement('fx-lazy', {
    // Lit reflects defaults when the element upgrades, before hydration: those attributes are its own.
    suppressHydrationWarning: true,
    ...rest,
    ref,
    label,
    active: active ? '' : undefined,
  });
});
