{
  // The fixture sources (legacy decorators, as the analyzer and Lit expect).
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/_dep"
  ]
}
