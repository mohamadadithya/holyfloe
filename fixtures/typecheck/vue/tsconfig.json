{
  // vue-tsc on generated Vue output (fixtures/out/vue) and consumer tests. TypeScript 6: vue-tsc
  // needs the classic compiler API, which TypeScript 7 does not ship (D-071).
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    // Files live outside this package, so pin where vue resolves (as typecheck/react19 does for react).
    "paths": {
      "vue": ["./node_modules/vue"]
    }
  },
  "vueCompilerOptions": { "strictTemplates": true },
  "include": ["../../out/vue/**/*", "../../consumers/vue/**/*"]
}
