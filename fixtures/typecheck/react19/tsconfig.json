{
  // Type-checks generated React output and consumer tests against @types/react 19.
  // skipLibCheck stays off: react-types output is .d.ts and must be checked too.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    // Files live outside this package, so pin resolution of react and the fixtures here.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@holyfloe/fixtures/*": ["../../dist/*"]
    }
  },
  "include": ["../../expected/react/**/*", "../../consumers/react/**/*", "../../expected/react-types/**/*", "../../consumers/react-types/**/*"]
}
