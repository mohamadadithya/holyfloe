{
  // Type-checks generated wrapper output (fixtures/out/react) and its consumer tests against @types/react 18.
  // Types mode and `react.ref: "prop"` are React 19 only, so react19 checks them.
  // skipLibCheck stays off, so generated .d.ts files are checked too.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    // Files live outside this package, so pin where react resolves. @holyfloe/fixtures is
    // deliberately not mapped: it resolves through its own package.json exports (OQ-014).
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["../../out/react/**/*", "../../consumers/react/**/*"]
}
