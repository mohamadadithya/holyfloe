{
  // Type-checks generated React output and consumer tests against @types/react 18.
  // skipLibCheck stays off: react-types output is .d.ts and must be checked too.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    // Files live outside this package, so pin where react resolves. @holyfloe/fixtures is
    // deliberately not mapped: it resolves through its own package.json exports (OQ-014).
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["../../expected/react/**/*", "../../consumers/react/**/*"]
}
